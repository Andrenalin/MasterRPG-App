    },
    "The dice roller widget uses Apple's new Liquid Glass design, which creates a beautiful glass-like effect that blurs content behind it and reflects surrounding colors." : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Würfel-Widget verwendet Apples neues Liquid-Glass-Design. Es erzeugt einen glasartigen Effekt, der Inhalte dahinter weichzeichnet und Farben aus der Umgebung aufnimmt." } } }
    },
    "The widget displays your last rolled dice configuration" : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Widget zeigt deine zuletzt gewürfelte Würfelkonfiguration an" } } }
    },
    "These dice will appear in the widget during active gameplay. Tap Edit to reorder." : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Würfel erscheinen während eines aktiven Spiels im Widget. Tippe zum Sortieren auf „Bearbeiten“." } } }
