  "strings" : {
    "%@" : {
      "comment" : "The title and image to show in the Spotlight search results for this item.",
      "isCommentAutoGenerated" : true
    },
    "%@ %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        },
