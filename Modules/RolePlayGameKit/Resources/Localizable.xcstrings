{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ additional warnings are retained in the RuleRPG archive." : {
      "comment" : "A footnote that shows the number of additional warnings that are not shown in the list.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ weitere Warnungen werden im RuleRPG-Archiv beibehalten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ คำเตือนเพิ่มเติมถูกเก็บไว้ในไฟล์เก็บถาวร RuleRPG"
          }
        }
      }
    },
    "%@ assets are remote, installation-relative, or missing and will not be fetched automatically." : {
      "comment" : "A warning that indicates that some assets in a package are not available locally.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dateien sind extern, installationsrelativ oder fehlen und werden nicht automatisch abgerufen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ แอสเซตอยู่ในระยะไกล สัมพันธ์กับการติดตั้ง หรือไม่พบ และจะไม่ถูกดึงข้อมูลโดยอัตโนมัติ"
          }
        }
      }
    },
