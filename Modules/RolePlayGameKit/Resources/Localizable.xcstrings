    "The database context is not available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datenbankkontext ist nicht verfügbar."
          }
        }
      }
    },
    "The database could not be loaded. Underlying error: %@. The app can recover by removing the database file, but all data will be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank konnte nicht geladen werden. Zugrunde liegender Fehler: %@. Die App kann die Datenbankdatei entfernen, um den Fehler zu beheben. Dabei gehen jedoch alle Daten verloren."
          }
        }
      }
    },
    "The database could not be recreated on this device. Underlying error: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank konnte auf diesem Gerät nicht neu erstellt werden. Zugrunde liegender Fehler: %@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ไม่สามารถสร้างฐานข้อมูลใหม่บนอุปกรณ์นี้ได้ ข้อผิดพลาดที่เกิดขึ้น: %@"
          }
        }
      }
    },
    "The database could not be removed from this device. The app cannot recover automatically. Underlying error: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank konnte von diesem Gerät nicht entfernt werden. Die App kann den Fehler nicht automatisch beheben. Zugrunde liegender Fehler: %@"
          }
        }
      }
    },
    "The database models could not be loaded. The app installation may be damaged. Delete and reinstall the app. Recovery is not possible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbankmodelle konnten nicht geladen werden. Die App-Installation ist möglicherweise beschädigt. Lösche die App und installiere sie erneut. Eine Wiederherstellung ist nicht möglich."
          }
        }
      }
    },
    "The example data has been installed. You will find the data in the other sections." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Beispieldaten wurden installiert. Du findest die Daten in den anderen Bereichen."
          }
        }
      }
    },
    "The iCloud account is not available. Please check your iCloud settings. If you continue, data cannot be synced between devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iCloud-Konto ist nicht verfügbar. Bitte überprüfe deine iCloud-Einstellungen. Wenn du fortfährst, können Daten nicht zwischen Geräten synchronisiert werden."
          }
        }
      }
    },
    "The selected module is not supported in the share extension." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Modul wird von der Teilen-Erweiterung nicht unterstützt."
          }
        }
