    "The quick editor allows you to add all rooms for the map at once. The first line is the title and the next text represents the description of the room. An empty line is used to separate rooms." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schnelleditor erlaubt das hinzufügen von allen Räumen für eine Karte auf einmal. Die erste Zeile ist der Titel und die nächsten Zeilen sind der Inhalt vom Raum. Eine Leerzeile ist der Trenner für den nächsten Raum."
          }
        }
      }
    },
    "Thickness" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stärke"
          }
        }
      }
    },
