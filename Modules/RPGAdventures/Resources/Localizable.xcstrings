            "value" : "Tabelle"
          }
        }
      }
    },
    "The quick editor allows you to add all chapters for the adventure at once. The first line is the title and the next text represents the content of the chapter. An empty line is used to separate chapters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schnelleditor erlaubt das hinzufügen von allen Kapitel für ein Abenteuer auf einmal. Die erste Zeile ist der Titel und die nächsten Zeilen sind der Inhalt vom Kapitel. Eine Leerzeile ist der Trenner für das nächste Kapitel."
          }
        }
      }
    },
    "Undo %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widerrufen %@"
