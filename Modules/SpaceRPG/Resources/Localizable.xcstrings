    "Your object may have single color surfaces or be too reflective to add more segments.\nTap Continue to capture more detail without flipping, or Flip Object Anyway. (Review, Object Capture)" : {
      "comment" : "Feedback that this object is likely to fail if flipped.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Objekt hat möglicherweise einfarbige Oberflächen oder reflektiert zu stark, um weitere Segmente hinzuzufügen.\nTippe auf „Fortfahren“, um ohne Umdrehen weitere Details zu erfassen, oder auf „Objekt trotzdem umdrehen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your object may have single color surfaces or be too reflective to add more segments.\nTap Continue to capture more detail without flipping, or Flip Object Anyway."
