        float3 xformOp:translate = (-41.664867, 1.1752653, 21.091951)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "player_pawn_purple_assembly" (
        active = true
