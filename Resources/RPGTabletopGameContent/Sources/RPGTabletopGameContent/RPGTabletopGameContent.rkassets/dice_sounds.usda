    def RealityKitAudioFile "dieSoundLong_mp3"
    {
        uniform asset file = @dieSoundLong.mp3@
    }

    def RealityKitAudioFile "dieSoundShort_mp3"
    {
        uniform asset file = @dieSoundShort.mp3@
    }
}
