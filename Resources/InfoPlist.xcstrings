    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MasterRPG benutzt die Kamera um Fotos aufzunehmen und im Foto Modul hinzu zufügen. Diese Fotos können dann als Charakterbilder, Karten oder im Abenteuer verwendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MasterRPG uses the camera to take photos for the photo module and other modules to show photos and maps"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MasterRPG ใช้กล้องเพื่อถ่ายภาพสำหรับโมดูลภาพถ่ายและโมดูลอื่น ๆ เพื่อแสดงภาพถ่ายและแผนที่"
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription" : {
      "comment" : "Privacy - Desktop Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MasterRPG möchte auf die Dateien von deinem Schreibtisch zugreifen. Die ausgewählten Dateien können 3D Objekt Modelle, PDFs, Bilder oder Musik sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MasterRPG reads from the Desktop folder if the user select files like pdfs, images or audio for the game."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MasterRPG อ่านข้อมูลจากโฟลเดอร์เดสก์ท็อปเมื่อผู้ใช้เลือกไฟล์ เช่น PDF รูปภาพ หรือเสียงสำหรับเกม"
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription" : {
      "comment" : "Privacy - Documents Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MasterRPG möchte auf die Dateien von deinem Dokumenten Ordner zugreifen. Die ausgewählten Dateien können 3D Objekt Modelle, PDFs, Bilder oder Musik sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MasterRPG reads from the Documents folder if the user select files like pdfs, images or audio for the game."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MasterRPG อ่านข้อมูลจากโฟลเดอร์เอกสารเมื่อผู้ใช้เลือกไฟล์ เช่น PDF รูปภาพ หรือเสียงสำหรับเกม"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription" : {
      "comment" : "Privacy - Downloads Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MasterRPG möchte auf die Dateien von deinem Download Ordner zugreifen. Die ausgewählten Dateien können 3D Objekt Modelle, PDFs, Bilder oder Musik sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MasterRPG reads from the Download folder if the user select files like pdfs, images or audio for the game."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MasterRPG อ่านข้อมูลจากโฟลเดอร์ดาวน์โหลดเมื่อผู้ใช้เลือกไฟล์ เช่น PDF รูปภาพ หรือเสียงสำหรับเกม"
          }
        }
      }
    },
    "NSHandsTrackingUsageDescription" : {
      "comment" : "Privacy - Hands Tracking Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MasterRPG verwendet Handerkennung, damit du den 3D-Spieltisch durch Zusammenkneifen beider Hände in der Größe verändern kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MasterRPG uses hand tracking to let you resize the 3D game table by pinching with both hands."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MasterRPG ใช้การติดตามมือเพื่อให้คุณปรับขนาดโต๊ะเกม 3D ได้โดยการหยิกด้วยมือทั้งสองข้าง"
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "Copyright (human-readable)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "© Copyright 2024-2026, Andre Trettin"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "© Copyright 2024-2026, Andre Trettin"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "© Copyright 2024-2026, Andre Trettin"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MasterRPG möchte auf dein lokales Netzwerk zugreifen um ein Spiel als Spielleiter anzukündigen. Andere Spieler von anderen Geräten können dann einem Spiel im lokalen Netzwerk beitreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MasterRPG uses the local network to connect with other player around you to share maps from the GameMaster"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MasterRPG ใช้เครือข่ายในพื้นที่เพื่อเชื่อมต่อกับผู้เล่นคนอื่นรอบตัวคุณ เพื่อแชร์แผนที่จากเกมมาสเตอร์"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MasterRPG benötigt Mikrofonzugriff für Sprachbefehle und Spracherkennungsfunktionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MasterRPG needs microphone access to enable voice commands and speech recognition features."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MasterRPG ต้องการการเข้าถึงไมโครโฟนเพื่อเปิดใช้งานคำสั่งเสียงและฟีเจอร์การจดจำเสียงพูด"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MasterRPG möchte auf deine Fotos in der Fotobibliothek zugreifen. Die ausgewählten Fotos können dann als Charakterbilder, Karten oder in Abenteuern verwendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MasterRPG uses the photo library to import photos for the photo module and other modules to show photos and maps"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MasterRPG ใช้คลังภาพเพื่อนำเข้าภาพถ่ายสำหรับโมดูลภาพถ่ายและโมดูลอื่น ๆ เพื่อแสดงภาพถ่ายและแผนที่"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MasterRPG verwendet Spracherkennung, um deine Sprachbefehle für den Sprachassistenten in Text umzuwandeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MasterRPG uses speech recognition to convert your voice commands into text for the voice assistant feature."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MasterRPG ใช้การจดจำเสียงพูดเพื่อแปลงคำสั่งเสียงของคุณเป็นข้อความสำหรับฟีเจอร์ผู้ช่วยเสียง"
          }
        }
      }
    },
    "NSWorldSensingUsageDescription" : {
      "comment" : "Privacy - World Sensing Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MasterRPG verwendet Welterkennungsdaten, um Tische für das Würfeln während des Spiels zu erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MasterRPG uses the world sensing data to detect tables for the dice rolling during the game."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MasterRPG ใช้ข้อมูลการรับรู้โลกเพื่อตรวจจับโต๊ะสำหรับการทอยลูกเต๋าระหว่างเกม"
          }
        }
      }
    },
    "Universal VTT Map" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal-VTT-Karte"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แผนที่ Universal VTT"
          }
        }
      }
    }
  },
  "version" : "1.3"
}
